# Copy this file to backend/.env and add your real values locally.
# NEVER commit backend/.env to GitHub.

# Optional. Without a key the system runs in rule-based mode.
GROQ_API_KEY=your_groq_api_key_here
LLM_MODEL=openai/gpt-oss-20b

# Pins "today" for the synthetic dataset. Leave empty ("") to use the real date.
AS_OF_DATE=2026-09-29
RETURN_WINDOW_DAYS=10
